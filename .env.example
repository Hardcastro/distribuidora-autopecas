# Fonte de dados do catálogo: "csv" (padrão) lê pecas.csv e aplicacoes.csv
# versionados no repo. "erp" fala com o ERP simulado em /api/erp via HTTP.
FONTE=csv

# Usados só quando FONTE=erp. Sem eles, o adaptador cai no fallback do CSV.
ERP_BASE_URL=http://localhost:3000/api/erp
ERP_TOKEN=anhanguera-dev-token
